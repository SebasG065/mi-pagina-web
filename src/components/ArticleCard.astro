---
import { getCategoryTheme, formatDateEs } from "../lib/articles.js";

const { article, showIcon = true } = Astro.props;
const theme = getCategoryTheme(article.category);
---

<article
  class="article-card"
  data-category={article.category}
  style={`--card-accent:${theme.accent}; --card-soft:${theme.soft};`}
>
  {
    article.imageUrl && (
      <div class="article-card-img-wrap">
        <img src={article.imageUrl} alt={article.title} class="article-card-img" />
      </div>
    )
  }
  <div class="article-card-body">
    <span class="tag">
      {showIcon && <span class="tag-icon">{theme.icon}</span>}
      {article.category}
    </span>
    <h3><a href={`/articulo/${article.slug}`}>{article.title}</a></h3>
    <p>{article.summary}</p>
    <div class="article-meta">
      <span>{article.author}</span>
      <span>{formatDateEs(article.createdAt)}</span>
    </div>
  </div>
</article>
