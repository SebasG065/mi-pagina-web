---
const {
  title,
  description,
  path = "/",
  ogType = "website",
  ogImage = "",
  jsonLd = null,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(path, Astro.site);
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9277636669272885"
      crossorigin="anonymous"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <nav class="navbar">
        <a href="/" class="logo">Binario</a>
        <ul class="nav-links">
          <li><a href="/">Inicio</a></li>
          <li><a href="/articulos">Artículos</a></li>
          <li><a href="/publicar">Publicar</a></li>
        </ul>
        <button class="nav-toggle" id="navToggle" aria-label="Abrir menú">☰</button>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <p>
        &copy; <span id="year"></span> Binario. Todos los derechos reservados. ·{" "}
        <a href="/privacidad" style="color:inherit;text-decoration:underline;">Privacidad</a>
      </p>
    </footer>

    <script src="/js/script.js" is:inline></script>
    <script src="/js/ads.js" is:inline></script>
  </body>
</html>
