---
import Layout from "../../layouts/Layout.astro";
import { readArticles, formatDateEs, escapeHtml } from "../../lib/articles.js";

const { slug } = Astro.params;
const articles = readArticles();
const article = articles.find((a) => a.slug === slug);

if (!article) {
  Astro.response.status = 404;
}

const canonicalPath = `/articulo/${slug}`;

const jsonLd = article
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: article.title,
      description: article.summary,
      author: { "@type": "Person", name: article.author },
      datePublished: article.createdAt,
      dateModified: article.updatedAt || article.createdAt,
      ...(article.imageUrl ? { image: [article.imageUrl] } : {}),
    })
  : null;

const bodyHtml = article ? escapeHtml(article.content).replace(/\n/g, "<br>") : "";
---

<Layout
  title={article ? `${article.title} | Binario` : "Artículo no encontrado | Binario"}
  description={article ? article.summary : "El artículo que buscas no existe o fue eliminado."}
  path={canonicalPath}
  ogType="article"
  ogImage={article?.imageUrl || ""}
  jsonLd={jsonLd}
>
  <main class="section">
    {
      article ? (
        <>
          <a href="/articulos" class="back-link">
            &larr; Volver a artículos
          </a>
          {article.imageUrl && (
            <img src={article.imageUrl} alt={article.title} class="article-detail-img" />
          )}
          <span class="tag">{article.category}</span>
          <h1>{article.title}</h1>
          <div class="article-meta">
            <span>Por {article.author}</span>
            <span>{formatDateEs(article.createdAt)}</span>
          </div>
          <div class="article-body" set:html={bodyHtml} />
          <div class="ad-slot" data-ad-slot-key="article" />
          <button id="deleteBtn" class="btn btn-danger" data-article-id={article.id}>
            Eliminar artículo
          </button>
        </>
      ) : (
        <p>Artículo no encontrado.</p>
      )
    }
  </main>

  <script src="/js/admin-auth.js" is:inline></script>
  <script src="/js/articulo.js" is:inline></script>
</Layout>
